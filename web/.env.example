# Public browser configuration. Copy this file to .env.local and replace the
# placeholders. The publishable key is designed for browser use; authorization
# is enforced by Supabase Auth and Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Public feature availability. Keep false until the Google provider, invited-user
# success, and uninvited-user rejection have passed against the target project.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Optional acceptance target. Leave disabled for the local isolated suite.
# Supply credentials only in the shell or CI secret store; never write them here.
LOCUM_E2E_LIVE=0
LOCUM_E2E_BASE_URL=https://YOUR_AUTHORIZED_ACCEPTANCE_DOMAIN
LOCUM_E2E_USER_EMAIL=
LOCUM_E2E_USER_PASSWORD=

# Server-only Google Calendar integration. Keep disabled until an authorized
# deployment injects all values through its protected runtime secret store.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_ORIGIN=
GOOGLE_CALENDAR_TOKEN_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only payment encryption. Supply a base64-encoded 32-byte random key
# through the protected runtime secret store. Never expose it with NEXT_PUBLIC_.
PAYMENT_DETAILS_MASTER_KEY=
